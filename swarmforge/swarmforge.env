# Per-project SwarmForge launch overrides. Sourced by the swarmforge
# launcher before per-role model and effort are resolved. Plain zsh
# assignments only. No secrets in this file; it is committed.
#
# Fleet policy: no codex. architect already defaults to Fable 5 in
# swarmforge.sh; specifier is pinned to match here since it isn't one of
# the roles hardcoded to Fable. refactorer is pinned to Opus for the same
# reason (its catch-all default would otherwise just inherit whatever
# model the claude CLI defaults to).
SWARMFORGE_SPECIFIER_MODEL=claude-fable-5
SWARMFORGE_REFACTORER_MODEL=claude-opus-4-8

# Coder's one-flip fallback: if grok isn't available, switch the coder
# agent to claude in swarmforge.conf and relaunch. This model only takes
# effect once that flip happens (the grok backend ignores it).
SWARMFORGE_CODER_MODEL=claude-sonnet-5
